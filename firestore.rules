rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().size() <= 5
        && data.uid is string && data.uid.size() <= 128
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 256))
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 50))
        && data.createdAt == request.time;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'priority', 'completed', 'createdAt'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 512
        && data.category is string && (data.category == 'work' || data.category == 'personal')
        && data.priority is string && (data.priority == 'high' || data.priority == 'normal' || data.priority == 'system')
        && data.completed is bool
        && (data.estimatedEnergy == null || (data.estimatedEnergy is string && data.estimatedEnergy.size() <= 256))
        && (data.dueDateText == null || (data.dueDateText is string && data.dueDateText.size() <= 256))
        && data.createdAt is timestamp;
    }

    function isValidAlarm(data) {
      return data.keys().hasAll(['id', 'userId', 'time', 'title', 'active', 'createdAt'])
        && data.keys().size() <= 6
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.time is string && data.time.size() <= 50
        && data.title is string && data.title.size() <= 256
        && data.active is bool
        && data.createdAt is timestamp;
    }

    // Rules for individual collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) 
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'phoneNumber'])
        && (request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 256))
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 256))
        && (request.resource.data.phoneNumber == null || (request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 50));
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && isValidId(taskId)
        && isValidTask(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTask(request.resource.data)
        && (
          // Toggle Completed
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed']) ||
          // Update details
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'priority', 'estimatedEnergy', 'dueDateText'])
        );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /alarms/{alarmId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && isValidId(alarmId)
        && isValidAlarm(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidAlarm(request.resource.data)
        && (
          // Toggle active
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) ||
          // Edit details
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'time', 'active'])
        );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

  }
}
